{
  "name": "telugu-calendar-utilities-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:site && npm run build:docs && npm run docs:check-output",
    "build:site": "npm run typecheck && vite build",
    "build:docs": "node tools/generate-docs-computations.mjs && node tools/check-docs-source.mjs && vitepress build . && node tools/compose-docs-data.mjs",
    "dev:docs": "node tools/generate-docs-computations.mjs && vitepress dev .",
    "preview:docs": "vitepress preview .",
    "docs:check-output": "node tools/check-docs-output.mjs",
    "lint": "eslint \"src/**/*.ts\" vite.config.ts \".vitepress/**/*.ts\" --max-warnings 0 --no-inline-config --suppressions-location eslint-suppressions.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.panels.json --noEmit",
    "activity:export": "python3 tools/export_activity_rules.py",
    "activity:check": "python3 tools/export_activity_rules.py --check && python3 tools/export_election_chart_rules.py --check && python3 tools/export_muhurtam_rule_crosswalk.py --check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "4.1.9",
    "eslint": "10.10.0",
    "jsdom": "^24.0.0",
    "mermaid": "11.17.2",
    "typescript": "^5.5.0",
    "typescript-eslint": "8.69.0",
    "vite": "^8.0.16",
    "vitepress": "1.6.4",
    "vitest": "4.1.9"
  },
  "overrides": {
    "vitepress": {
      "vite": "6.4.3"
    }
  }
}
