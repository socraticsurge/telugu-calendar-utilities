{
  "name": "telugu-calendar-utilities-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.panels.json --noEmit",
    "activity:export": "python3 tools/export_activity_rules.py",
    "activity:check": "python3 tools/export_activity_rules.py --check"
  },
  "devDependencies": {
    "vite": "^8.0.16",
    "vitest": "^4.1.9",
    "typescript": "^5.5.0",
    "@types/node": "^20.14.0",
    "jsdom": "^24.0.0"
  }
}
